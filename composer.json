{
  "name": "studapart/adf-tools",
  "description": "Atlassian Document Format PHP Tools (Studapart fork of DamienHarper/adf-tools 1.2.1)",
  "minimum-stability": "stable",
  "keywords": ["atlassian", "adf"],
  "license": "MIT",
  "homepage": "https://github.com/Studapart/adf-tools",
  "authors": [
    {
      "name": "Damien Harper",
      "email": "damien.harper@gmail.com"
    },
    {
      "name": "Studapart",
      "homepage": "https://github.com/Studapart"
    }
  ],
  "support": {
    "issues": "https://github.com/Studapart/adf-tools/issues",
    "source": "https://github.com/Studapart/adf-tools"
  },
  "replace": {
    "damienharper/adf-tools": "self.version"
  },
  "require": {
    "php": ">=7.4",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "DH\\Adf\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DH\\Adf\\Tests\\": "tests"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "symfony/var-dumper": "^5.0 || ^6.0 || ^7.0 || ^8.0"
  },
  "scripts": {
    "test": "php -d pcov.enabled=1 ./vendor/bin/phpunit --colors=always",
    "csfixer": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --using-cache=no --verbose --ansi",
    "cs-check": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --using-cache=no --verbose --ansi --dry-run",
    "phpstan": "tools/phpstan/vendor/bin/phpstan --ansi analyse src",
    "rector": "tools/rector/vendor/bin/rector process src",
    "update-tools": "composer update --working-dir=tools/php-cs-fixer ; composer update --working-dir=tools/phpstan ; composer update --working-dir=tools/rector"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.x-dev"
    }
  }
}
